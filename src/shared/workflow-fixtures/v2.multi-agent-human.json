{
  "id": "builtin.v2.multi-agent-human",
  "name": "V2 多 Agent 人工收口",
  "scope": "built-in",
  "version": 1,
  "definition": {
    "schemaVersion": 2,
    "decisionProtocolVersion": "v2-binary-zh",
    "entryStepId": "research",
    "roleSlots": [
      {
        "id": "researcher",
        "label": "调研 Agent",
        "required": true,
        "minAgents": 1,
        "maxAgents": 1,
        "execution": "single",
        "allowedAgentStates": ["idle"]
      },
      {
        "id": "writer",
        "label": "撰写 Agent",
        "required": true,
        "minAgents": 1,
        "maxAgents": 2,
        "execution": "parallel",
        "allowedAgentStates": ["idle"]
      },
      {
        "id": "judge",
        "label": "判定 Agent",
        "required": true,
        "minAgents": 1,
        "maxAgents": 1,
        "execution": "single",
        "allowedAgentStates": ["idle"]
      }
    ],
    "steps": [
      {
        "id": "research",
        "name": "调研",
        "kind": "agent",
        "roleSlotIds": ["researcher"],
        "execution": "single",
        "prompt": {
          "variants": [
            {
              "when": "always",
              "template": "目标：\n{{goal}}\n\n请调研并输出要点。\n\n完成条件：\n{{criteria}}"
            }
          ],
          "completionCriteria": "覆盖关键背景与约束。"
        },
        "retryPolicy": { "maxAttempts": 1, "backoffMs": 0, "onExhausted": "human" },
        "next": { "targetStepId": "write" }
      },
      {
        "id": "write",
        "name": "撰写",
        "kind": "agent",
        "roleSlotIds": ["writer"],
        "execution": "parallel",
        "prompt": {
          "variants": [
            {
              "when": "always",
              "template": "目标：\n{{goal}}\n\n调研：\n{{ history[currentRound].nodes[\"research\"].output }}\n\n请撰写结果。\n\n完成条件：\n{{criteria}}"
            }
          ],
          "completionCriteria": "形成可判定的完整文稿。"
        },
        "retryPolicy": { "maxAttempts": 2, "backoffMs": 0, "onExhausted": "human" },
        "next": { "targetStepId": "judge" }
      },
      {
        "id": "judge",
        "name": "判定",
        "kind": "decision",
        "roleSlotIds": ["judge"],
        "prompt": {
          "variants": [
            {
              "when": "always",
              "template": "目标：\n{{goal}}\n\n文稿：\n{{ history[currentRound].nodes[\"write\"].output }}\n\n第一条非空行只能是完成或不完成。"
            }
          ],
          "completionCriteria": "文稿可用。"
        },
        "parser": "binary-complete",
        "routes": {
          "whenTrue": { "targetStepId": "end" },
          "whenFalse": { "targetStepId": "human" },
          "whenInvalid": { "targetStepId": "human" }
        },
        "retryPolicy": { "maxAttempts": 1, "backoffMs": 0, "onExhausted": "human" }
      },
      {
        "id": "human",
        "name": "人工决策",
        "kind": "human",
        "routes": [
          {
            "id": "retry-write",
            "label": "退回撰写",
            "targetStepId": "write",
            "requiresText": true,
            "requiresConfirmation": true
          },
          {
            "id": "accept",
            "label": "人工通过",
            "targetStepId": "end",
            "requiresText": false,
            "requiresConfirmation": true
          }
        ]
      },
      {
        "id": "end",
        "name": "完成",
        "kind": "end",
        "outcome": "succeeded"
      }
    ]
  }
}

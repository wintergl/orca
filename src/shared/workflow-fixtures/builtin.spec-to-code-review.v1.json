{
  "id": "builtin.spec-to-code-review.v1",
  "name": "SPEC → 实现完整流程",
  "scope": "built-in",
  "version": 4,
  "definition": {
    "schemaVersion": 1,
    "entryNodeId": "spec-produce",
    "defaults": {
      "retryPolicy": { "maxAttempts": 2, "backoffMs": 1000, "onExhausted": "wait-human" }
    },
    "roleSlots": [
      {
        "id": "spec-author",
        "label": "SPEC 编写 Agent",
        "required": true,
        "minAgents": 1,
        "maxAgents": 1,
        "execution": "single",
        "allowedAgentStates": ["idle"]
      },
      {
        "id": "spec-reviewers",
        "label": "SPEC 评审 Agent",
        "required": true,
        "minAgents": 1,
        "maxAgents": 8,
        "execution": "parallel",
        "allowedAgentStates": ["idle"]
      },
      {
        "id": "spec-decider",
        "label": "SPEC 判定 Agent",
        "required": false,
        "minAgents": 0,
        "maxAgents": 1,
        "execution": "single",
        "allowedAgentStates": ["idle"]
      },
      {
        "id": "implementer",
        "label": "代码实现 Agent",
        "required": true,
        "minAgents": 1,
        "maxAgents": 1,
        "execution": "single",
        "allowedAgentStates": ["idle"]
      },
      {
        "id": "code-reviewers",
        "label": "代码评审 Agent",
        "required": true,
        "minAgents": 1,
        "maxAgents": 8,
        "execution": "parallel",
        "allowedAgentStates": ["idle"]
      },
      {
        "id": "code-decider",
        "label": "代码判定 Agent",
        "required": false,
        "minAgents": 0,
        "maxAgents": 1,
        "execution": "single",
        "allowedAgentStates": ["idle"]
      }
    ],
    "nodes": [
      {
        "id": "spec-produce",
        "name": "SPEC 编写",
        "type": "produce",
        "roleSlotIds": ["spec-author"],
        "promptTemplateKey": "builtin.spec.produce.v1",
        "promptInstructions": "当前工作目标为：\n{{rootGoal}}\n\n请完成本轮 SPEC。\n\n上一轮评审意见：\n{{reviewAggregate}}\n\n人工修改要求：\n{{humanInstructions}}",
        "inputBindings": ["root-goal", "review-aggregate"],
        "retryPolicy": { "maxAttempts": 2, "backoffMs": 1000, "onExhausted": "wait-human" },
        "artifactKind": "spec",
        "outputSchema": "workflow.completion/v1"
      },
      {
        "id": "spec-review",
        "name": "SPEC 评审",
        "type": "review",
        "roleSlotIds": ["spec-reviewers"],
        "promptTemplateKey": "builtin.spec.review.v1",
        "promptInstructions": "当前工作目标为：\n{{rootGoal}}\n\n上游 Agent 的完成结论为：\n{{upstreamCompletion}}\n\n本轮完成的 SPEC 为：\n{{artifactRevision}}\n\n请结合工作目标和冻结的 SPEC 评审此结果。",
        "inputBindings": ["root-goal", "upstream-completion", "artifact-revision"],
        "retryPolicy": { "maxAttempts": 2, "backoffMs": 1000, "onExhausted": "wait-human" },
        "reviewPolicy": {
          "minReviewers": 1,
          "completion": "all-required",
          "onReviewerFailure": "wait-human",
          "timeoutMs": 3600000,
          "maxReviewRounds": 3
        },
        "outputSchema": "workflow.review-result/v1"
      },
      {
        "id": "spec-decide",
        "name": "SPEC 判定",
        "type": "decide",
        "roleSlotIds": ["spec-decider"],
        "promptTemplateKey": "builtin.spec.decide.v1",
        "promptInstructions": "当前工作目标为：\n{{rootGoal}}\n\n本轮完成的 SPEC 为：\n{{artifactRevision}}\n\n评审汇总为：\n{{reviewAggregate}}\n\n请判断该 SPEC 应通过、修改或请求人工处理。",
        "inputBindings": ["root-goal", "artifact-revision", "review-aggregate"],
        "retryPolicy": { "maxAttempts": 2, "backoffMs": 1000, "onExhausted": "wait-human" },
        "mode": "rules-then-agent",
        "outputSchema": "workflow.decision/v1"
      },
      {
        "id": "spec-human",
        "name": "SPEC 人工决定",
        "type": "human-gate",
        "roleSlotIds": [],
        "promptTemplateKey": null,
        "promptInstructions": null,
        "inputBindings": ["artifact-revision", "review-aggregate", "decision"],
        "retryPolicy": { "maxAttempts": 0, "backoffMs": 0, "onExhausted": "wait-human" },
        "waitingReasons": [
          "review-request-human",
          "review-revision-required",
          "review-conflict",
          "review-limit-reached",
          "decision-invalid"
        ],
        "allowedActions": [
          "view-evidence",
          "approve",
          "revise",
          "continue-round",
          "retry-step",
          "end-workflow"
        ],
        "outputSchema": "workflow.human-resolution/v1"
      },
      {
        "id": "code-produce",
        "name": "代码实现",
        "type": "produce",
        "roleSlotIds": ["implementer"],
        "promptTemplateKey": "builtin.code.produce.v1",
        "promptInstructions": "当前工作目标为：\n{{rootGoal}}\n\n已确认的 SPEC 或上游结果为：\n{{artifactRevision}}\n\n上游 Agent 的完成结论为：\n{{upstreamCompletion}}\n\n上一轮代码评审汇总为：\n{{reviewAggregate}}\n\n人工修改要求：\n{{humanInstructions}}\n\n请依据上述内容实现或修订代码。",
        "inputBindings": [
          "root-goal",
          "upstream-completion",
          "artifact-revision",
          "review-aggregate"
        ],
        "retryPolicy": { "maxAttempts": 2, "backoffMs": 1000, "onExhausted": "wait-human" },
        "artifactKind": "code",
        "outputSchema": "workflow.completion/v1"
      },
      {
        "id": "code-review",
        "name": "代码评审",
        "type": "review",
        "roleSlotIds": ["code-reviewers"],
        "promptTemplateKey": "builtin.code.review.v1",
        "promptInstructions": "当前工作目标为：\n{{rootGoal}}\n\n上游 Agent 的完成结论为：\n{{upstreamCompletion}}\n\n本轮完成的代码为：\n{{artifactRevision}}\n\n请结合工作目标和冻结的代码评审此结果。",
        "inputBindings": ["root-goal", "upstream-completion", "artifact-revision"],
        "retryPolicy": { "maxAttempts": 2, "backoffMs": 1000, "onExhausted": "wait-human" },
        "reviewPolicy": {
          "minReviewers": 1,
          "completion": "all-required",
          "onReviewerFailure": "wait-human",
          "timeoutMs": 3600000,
          "maxReviewRounds": 3
        },
        "outputSchema": "workflow.review-result/v1"
      },
      {
        "id": "code-decide",
        "name": "代码判定",
        "type": "decide",
        "roleSlotIds": ["code-decider"],
        "promptTemplateKey": "builtin.code.decide.v1",
        "promptInstructions": "当前工作目标为：\n{{rootGoal}}\n\n本轮完成的代码为：\n{{artifactRevision}}\n\n评审汇总为：\n{{reviewAggregate}}\n\n请判断该实现应通过、修改或请求人工处理。",
        "inputBindings": ["root-goal", "artifact-revision", "review-aggregate"],
        "retryPolicy": { "maxAttempts": 2, "backoffMs": 1000, "onExhausted": "wait-human" },
        "mode": "rules-then-agent",
        "outputSchema": "workflow.decision/v1"
      },
      {
        "id": "code-human",
        "name": "代码人工决定",
        "type": "human-gate",
        "roleSlotIds": [],
        "promptTemplateKey": null,
        "promptInstructions": null,
        "inputBindings": ["artifact-revision", "review-aggregate", "decision"],
        "retryPolicy": { "maxAttempts": 0, "backoffMs": 0, "onExhausted": "wait-human" },
        "waitingReasons": [
          "review-request-human",
          "review-revision-required",
          "review-conflict",
          "review-limit-reached",
          "decision-invalid"
        ],
        "allowedActions": [
          "view-evidence",
          "approve",
          "revise",
          "continue-round",
          "retry-step",
          "end-workflow"
        ],
        "outputSchema": "workflow.human-resolution/v1"
      },
      {
        "id": "complete",
        "name": "完成",
        "type": "complete",
        "roleSlotIds": [],
        "promptTemplateKey": null,
        "promptInstructions": null,
        "inputBindings": ["decision"],
        "retryPolicy": { "maxAttempts": 0, "backoffMs": 0, "onExhausted": "fail-run" },
        "outcome": "succeeded",
        "outputSchema": null
      }
    ],
    "transitions": [
      {
        "id": "spec-produce-succeeded",
        "from": "spec-produce",
        "when": "step:succeeded",
        "to": "spec-review"
      },
      {
        "id": "spec-review-succeeded",
        "from": "spec-review",
        "when": "step:succeeded",
        "to": "spec-decide"
      },
      {
        "id": "spec-decision-approved",
        "from": "spec-decide",
        "when": "decision:approve",
        "to": "code-produce"
      },
      {
        "id": "spec-decision-revise",
        "from": "spec-decide",
        "when": "decision:revise",
        "to": "spec-produce"
      },
      {
        "id": "spec-decision-human",
        "from": "spec-decide",
        "when": "decision:request-human",
        "to": "spec-human"
      },
      {
        "id": "spec-decision-limit",
        "from": "spec-decide",
        "when": "decision:stop-at-review",
        "to": "run:review-limit-reached"
      },
      {
        "id": "spec-human-approved",
        "from": "spec-human",
        "when": "human:approve",
        "to": "code-produce"
      },
      {
        "id": "spec-human-revise",
        "from": "spec-human",
        "when": "human:revise",
        "to": "spec-produce"
      },
      { "id": "spec-human-end", "from": "spec-human", "when": "human:end", "to": "run:cancelled" },
      {
        "id": "code-produce-succeeded",
        "from": "code-produce",
        "when": "step:succeeded",
        "to": "code-review"
      },
      {
        "id": "code-review-succeeded",
        "from": "code-review",
        "when": "step:succeeded",
        "to": "code-decide"
      },
      {
        "id": "code-decision-approved",
        "from": "code-decide",
        "when": "decision:approve",
        "to": "complete"
      },
      {
        "id": "code-decision-revise",
        "from": "code-decide",
        "when": "decision:revise",
        "to": "code-produce"
      },
      {
        "id": "code-decision-human",
        "from": "code-decide",
        "when": "decision:request-human",
        "to": "code-human"
      },
      {
        "id": "code-decision-limit",
        "from": "code-decide",
        "when": "decision:stop-at-review",
        "to": "run:review-limit-reached"
      },
      {
        "id": "code-human-approved",
        "from": "code-human",
        "when": "human:approve",
        "to": "complete"
      },
      {
        "id": "code-human-revise",
        "from": "code-human",
        "when": "human:revise",
        "to": "code-produce"
      },
      { "id": "code-human-end", "from": "code-human", "when": "human:end", "to": "run:cancelled" }
    ]
  }
}

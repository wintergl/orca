exports[`WorkflowDefinitionV1 > validates and snapshots every complete built-in fixture 1`] = `
[
  {
    "definition": {
      "defaults": {
        "retryPolicy": {
          "backoffMs": 1000,
          "maxAttempts": 2,
          "onExhausted": "wait-human",
        },
      },
      "entryNodeId": "spec-produce",
      "nodes": [
        {
          "artifactKind": "spec",
          "id": "spec-produce",
          "inputBindings": [
            "root-goal",
            "review-aggregate",
          ],
          "name": "SPEC 编写",
          "outputSchema": "workflow.completion/v1",
          "promptInstructions": "当前工作目标为：
{{rootGoal}}

请完成本轮 SPEC。

上一轮评审意见：
{{reviewAggregate}}

人工修改要求：
{{humanInstructions}}",
          "promptTemplateKey": "builtin.spec.produce.v1",
          "retryPolicy": {
            "backoffMs": 1000,
            "maxAttempts": 2,
            "onExhausted": "wait-human",
          },
          "roleSlotIds": [
            "spec-author",
          ],
          "type": "produce",
        },
        {
          "id": "spec-review",
          "inputBindings": [
            "root-goal",
            "upstream-completion",
            "artifact-revision",
          ],
          "name": "SPEC 评审",
          "outputSchema": "workflow.review-result/v1",
          "promptInstructions": "当前工作目标为：
{{rootGoal}}

上游 Agent 的完成结论为：
{{upstreamCompletion}}

本轮完成的 SPEC 为：
{{artifactRevision}}

请结合工作目标和冻结的 SPEC 评审此结果。",
          "promptTemplateKey": "builtin.spec.review.v1",
          "retryPolicy": {
            "backoffMs": 1000,
            "maxAttempts": 2,
            "onExhausted": "wait-human",
          },
          "reviewPolicy": {
            "completion": "all-required",
            "maxReviewRounds": 3,
            "minReviewers": 1,
            "onReviewerFailure": "wait-human",
            "timeoutMs": 3600000,
          },
          "roleSlotIds": [
            "spec-reviewers",
          ],
          "type": "review",
        },
        {
          "id": "spec-decide",
          "inputBindings": [
            "root-goal",
            "artifact-revision",
            "review-aggregate",
          ],
          "mode": "rules-then-agent",
          "name": "SPEC 判定",
          "outputSchema": "workflow.decision/v1",
          "promptInstructions": "当前工作目标为：
{{rootGoal}}

本轮完成的 SPEC 为：
{{artifactRevision}}

评审汇总为：
{{reviewAggregate}}

请判断该 SPEC 应通过、修改或请求人工处理。",
          "promptTemplateKey": "builtin.spec.decide.v1",
          "retryPolicy": {
            "backoffMs": 1000,
            "maxAttempts": 2,
            "onExhausted": "wait-human",
          },

            "maxAttempts": 0,
            "onExhausted": "fail-run",
          },
          "roleSlotIds": [],
          "type": "complete",
        },
      ],
      "roleSlots": [
        {
          "allowedAgentStates": [
            "idle",
          ],
          "execution": "single",
          "id": "spec-author",
          "label": "SPEC 编写 Agent",
          "maxAgents": 1,
          "minAgents": 1,
          "required": true,
        },
        {
          "allowedAgentStates": [
            "idle",
          ],
          "execution": "parallel",
          "id": "spec-reviewers",

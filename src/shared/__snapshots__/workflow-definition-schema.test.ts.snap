          "to": "spec-review",
          "when": "step:succeeded",
        },
        {
          "from": "spec-review",
          "id": "spec-review-succeeded",
          "to": "spec-decide",
          "when": "step:succeeded",
        },
        {
          "from": "spec-decide",
          "id": "spec-decision-approved",
          "to": "complete",
          "when": "decision:approve",
        },
        {
          "from": "spec-decide",
          "id": "spec-decision-revise",
          "to": "spec-produce",
          "when": "decision:revise",
        },
        {
          "from": "spec-decide",
          "id": "spec-decision-human",
          "to": "spec-human",
          "when": "decision:request-human",
        },
        {
          "from": "spec-decide",
          "id": "spec-decision-limit",
          "to": "run:review-limit-reached",
          "when": "decision:stop-at-review",
        },
        {
          "from": "spec-human",
          "id": "spec-human-approved",
          "to": "complete",
          "when": "human:approve",
        },
        {
          "from": "spec-human",
          "id": "spec-human-revise",
          "to": "spec-produce",
          "when": "human:revise",
        },
        {
          "from": "spec-human",
          "id": "spec-human-end",
          "to": "run:cancelled",
          "when": "human:end",
        },
      ],
    },
